# cp .env.example .env  후 값 채우기
ANTHROPIC_API_KEY=

# Claude
CLAUDE_MODEL=claude-opus-5
MAX_INPUT_TOKENS=300000

# STT (로컬 whisper)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
STT_LANGUAGE=ko

# ---- Google Drive: 동기화 폴더 방식 (권장, 설정 불필요) ----
# Drive for desktop 이 돌고 있으면 여기에 복사만 하면 업로드된다.
# 비우면 G:~Z: 의 «내 드라이브» 를 자동 탐색한다.
# 탐색기에서 경로를 확인해 넣으세요. 예: G:\내 드라이브\회의록
SYNC_DIR=

# ---- Google Drive: API 방식 (공유 링크·Docs 변환이 필요할 때만) ----
DRIVE_FOLDER_NAME=회의록
DRIVE_PARENT_ID=
DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
DRIVE_CREDENTIALS=credentials.json
DRIVE_TOKEN=token.json
