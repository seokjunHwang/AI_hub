# ============================================================================
#  회의록 파이프라인 설정 — 사용자가 바꾸는 값은 «전부 여기» 에 있습니다
#
#  사용법   cp .env.example .env   후 아래 값 수정
#  주의     .env 를 고치면 노트북 «커널을 재시작» 해야 반영됩니다
#           (load_dotenv 는 import 할 때 한 번만 실행됩니다)
#
#  값을 비우면 각 항목의 «기본값» 이 쓰입니다.
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
#  1. 입력  —  무엇을 처리할지
# ────────────────────────────────────────────────────────────────────────────

#  둘 중 «하나만» 채웁니다. AUDIO 가 비어 있지 않으면 AUDIO 가 우선입니다.
#    AUDIO 채움      -> STT 를 돌려 녹취록을 만든다 (CPU 라 오래 걸림)
#    TRANSCRIPT 채움 -> STT 를 건너뛰고 그 파일을 그대로 쓴다
#  경로는 이 폴더 기준 상대경로를 권합니다 (절대경로도 됩니다).
INPUT_AUDIO=
INPUT_TRANSCRIPT=data/transcripts/mom_test1.txt

#  회의 제목·날짜. 파일명과 회의록 머리에 그대로 쓰입니다.
#  비우면 제목은 내용에서 생성되고, 날짜는 미지정으로 남습니다.
#  ※ 모델이 제목·날짜를 바꿔도 이 값으로 덮어씁니다 (우리가 아는 값은 모델에게 맡기지 않음)
MEETING_TITLE=
MEETING_DATE=


# ────────────────────────────────────────────────────────────────────────────
#  2. STT  —  오디오를 텍스트로 (INPUT_AUDIO 를 쓸 때만)
# ────────────────────────────────────────────────────────────────────────────

#  tiny / base / small / medium / large-v3
#    이 PC 는 AMD GPU 라 CPU 로만 돕니다 (CTranslate2 는 NVIDIA CUDA 전용).
#    large-v3 는 실시간보다 느립니다. 진행바의 «0.51x» 같은 배속을 보고 조절하세요.
WHISPER_MODEL=medium

#  auto / cpu / cuda    (auto = CUDA 있으면 GPU, 없으면 CPU)
WHISPER_DEVICE=auto

#  auto / int8 / float16    (auto = CPU 면 int8, GPU 면 float16)
WHISPER_COMPUTE=auto

#  녹취 언어. ko / en / ja ...
STT_LANGUAGE=ko


# ────────────────────────────────────────────────────────────────────────────
#  3. 추출  —  녹취록을 회의록 구조로
# ────────────────────────────────────────────────────────────────────────────

#  cli  = claude -p (Claude Code CLI) 사용.  API 키 불필요 «권장»
#  api  = Anthropic API 사용. ANTHROPIC_API_KEY 필요. 긴 회의 자동 분할이 장점
EXTRACT_MODE=cli

#  api 모드일 때만 필요합니다. cli 모드면 비워두세요.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

#  api 모드에서 입력이 이 토큰 수를 넘으면 분할 추출 후 병합합니다.
MAX_INPUT_TOKENS=300000


# ────────────────────────────────────────────────────────────────────────────
#  4. 검토  —  무엇을 문서에 반영할지
# ────────────────────────────────────────────────────────────────────────────

#  all        전부 반영
#  D1,A1,A3   고른 것만 (D=결정 / A=액션 / Q=미결. 검토 셀이 번호를 보여줍니다)
#  비움       노트북에서 직접 고름 (권장 — 회의에서 나온 말이 전부 결정은 아님)
ACCEPT=


# ────────────────────────────────────────────────────────────────────────────
#  5. 산출물  —  어디에 어떤 이름으로 저장할지
# ────────────────────────────────────────────────────────────────────────────

#  로컬 저장 폴더. 비우면 data/minutes
OUTPUT_DIR=

#  로컬 폴더 구조
#    flat     data/minutes/2026-08-25_킥오프.md
#    date     data/minutes/2026-08-25/2026-08-25_킥오프.md
#    nested   data/minutes/2026-08-25/킥오프/2026-08-25_킥오프.md   (기본)
OUTPUT_LAYOUT=nested

#  같은 이름이 있을 때
#    false  _v2, _v3 로 저장 (기본 — 덮어쓰지 않음)
#    true   덮어쓴다
OUTPUT_OVERWRITE=false


# ────────────────────────────────────────────────────────────────────────────
#  6. 전송  —  어디로 보낼지
# ────────────────────────────────────────────────────────────────────────────

#  api     Drive API 업로드. 공유 링크·Docs 변환. credentials.json 필요
#  sync    Drive for desktop 동기화 폴더로 복사. 설정 불필요, 계정 추가 필요
#  manual  탐색기 + drive.google.com 을 열어줌. 드래그로 직접
#  (비움)  로컬에만 저장
SEND=api

#  본인 Google 계정. sync 방식에서 «남의 드라이브로 가는 것» 을 막는 확인용
MY_DRIVE_EMAIL=

#  --- api 방식 ---
#  드라이브 최상위 폴더 이름.  내 드라이브 / <이 이름> / <회의별 폴더>
DRIVE_FOLDER_NAME=회의록

#  회의별 하위 폴더 규칙
#    slug   회의록 / 2026-08-25_킥오프 / 파일3개   (기본)
#    month  회의록 / 2026-08 / 파일들
#    none   회의록 / 파일들                        (평평하게)
DRIVE_SUBFOLDER=slug

#  특정 폴더 «안에» 넣고 싶을 때. 드라이브에서 폴더를 열었을 때 URL 끝의 ID
#    drive.google.com/drive/folders/1bGlj0APm...  ->  1bGlj0APm...
#  ※ 손으로 만든 폴더를 쓰려면 아래 DRIVE_SCOPE 를 올려야 합니다
DRIVE_PARENT_ID=

#  HTML 을 Google Docs 로 변환한 사본도 함께 올릴지
DRIVE_AS_GDOC=true

#  drive.file  이 앱이 만든 파일만 접근 (최소 권한, 기본)
#  drive       드라이브 전체 접근 — DRIVE_PARENT_ID 로 기존 폴더를 쓸 때만
#  ※ 바꾸면 token.json 을 지우고 재인증해야 합니다
DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

DRIVE_CREDENTIALS=credentials.json
DRIVE_TOKEN=token.json

#  --- sync 방식 ---
#  Drive for desktop 동기화 폴더. 탐색기에서 확인한 경로를 넣습니다.
#    예: G:\My Drive\회의록
#  ※ 비우면 자동 탐색하는데, 계정이 여러 개면 남의 드라이브로 갈 수 있어
#     명시하지 않으면 진행하지 않습니다.
SYNC_DIR=


# ────────────────────────────────────────────────────────────────────────────
#  7. 노션
# ────────────────────────────────────────────────────────────────────────────

#  올릴 상위 페이지/DB 이름 또는 URL. 비우면 노션 단계를 건너뜁니다.
#  Claude Code 의 노션 커넥터를 씁니다 — API 토큰 불필요
NOTION_TARGET=


# ────────────────────────────────────────────────────────────────────────────
#  8. 기타
# ────────────────────────────────────────────────────────────────────────────

#  확정 후 HTML 뷰어를 기본 브라우저로 열지
OPEN_HTML=false

#  api 추출 모드의 응답 대기 상한(초)
CLAUDE_TIMEOUT=900


# ── 9. GUI 런처 (회의록_GUI.bat 만 씀) ──────────────────────────────────────
#  bat 이 쓸 파이썬. 비우면 .venv -> PATH 순으로 찾습니다.
#  노트북과 «같은» 파이썬을 써야 패키지가 맞습니다.
PYTHON=
